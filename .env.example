# ============================================
# SERVER CONFIGURATION
# ============================================
NODE_ENV=development
PORT=3000
HOST=localhost

# ============================================
# DATABASE
# ============================================
DATABASE_PATH=./database/operacion_atlas.db
DATABASE_BACKUP_PATH=./database/backups

# ============================================
# JWT/AUTHENTICATION
# ============================================
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRATION=24h
BCRYPT_ROUNDS=10

# ============================================
# LDAP/ACTIVE DIRECTORY (Optional)
# ============================================
LDAP_ENABLED=false
LDAP_URL=ldap://your-ldap-server.com
LDAP_PORT=389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your_ldap_password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})
LDAP_TIMEOUT=5000

# ============================================
# SESSION
# ============================================
SESSION_SECRET=your_session_secret_change_in_production
SESSION_TIMEOUT=3600000

# ============================================
# GAME CONFIGURATION
# ============================================
# Difficulty times (minutes)
GAME_EASY_TIME=300
GAME_NORMAL_TIME=180
GAME_HARD_TIME=60

# Investigation action times (minutes)
INVESTIGATION_DATABASE_TIME=5
INVESTIGATION_WITNESS_TIME=15
INVESTIGATION_SURVEILLANCE_TIME=25
INVESTIGATION_DOCUMENTS_TIME=10

# ============================================
# SECURITY
# ============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=debug
LOG_FILE=./logs/operacion-atlas.log

# ============================================
# API
# ============================================
API_VERSION=v1
API_PREFIX=/api/v1
