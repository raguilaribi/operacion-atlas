# ==========================================
# OPERACIÓN ATLAS - Configuración de Entorno
# ==========================================

# Servidor
NODE_ENV=development
PORT=3000
HOST=localhost

# Base de Datos
DATABASE_PATH=./backend/db/atlas.db
DATABASE_BACKUP_PATH=./backend/db/backups

# JWT/Autenticación
JWT_SECRET=tu_secreto_super_secreto_cambiar_en_produccion_12345
JWT_EXPIRATION=7d
BCRYPT_ROUNDS=10

# LDAP/Active Directory (Opcional)
LDAP_ENABLED=false
LDAP_URL=ldap://your-ldap-server.com
LDAP_PORT=389
LDAP_BIND_DN=cn=admin,dc=example,dc=com
LDAP_BIND_PASSWORD=your_ldap_password
LDAP_SEARCH_BASE=ou=users,dc=example,dc=com
LDAP_SEARCH_FILTER=(uid={{username}})
LDAP_TIMEOUT=5000

# Sesión
SESSION_SECRET=tu_session_secret_cambiar_en_produccion
SESSION_TIMEOUT=1800000  # 30 minutos en ms
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=900000  # 15 minutos en ms

# Configuración del Juego
GAME_EASY_TIME=300       # 5 horas simuladas en minutos
GAME_NORMAL_TIME=180     # 3 horas simuladas en minutos
GAME_HARD_TIME=60        # 1 hora simulada en minutos

# Tiempos de Acciones de Investigación (minutos)
INVESTIGATION_DATABASE_TIME=5
INVESTIGATION_INTERROGATION_TIME=15
INVESTIGATION_SURVEILLANCE_TIME=25
INVESTIGATION_ANALYSIS_TIME=10

# Seguridad
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
CORS_ORIGIN=http://localhost:3000
CORS_CREDENTIALS=true

# Logging
LOG_LEVEL=debug
LOG_FILE=./logs/operacion-atlas.log

# API
API_VERSION=v1
API_PREFIX=/api/v1

# Admin
ADMIN_EMAIL=admin@atlas.local
ADMIN_USERNAME=atlas_admin
ADMIN_PASSWORD=Admin123456!  # CAMBIAR EN PRODUCCION

# Features
ENABLE_ADMIN_PANEL=true
ENABLE_RANKINGS=true
ENABLE_LEADERBOARD=true
